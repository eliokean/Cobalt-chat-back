# Copier en .env pour le développement local (ou définir dans l'hébergeur)
# SQLite local par défaut ; PostgreSQL : postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./cobalt_chat.db
# Générer : python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Liste séparée par des virgules (ou JSON)
ALLOWED_ORIGINS=http://localhost:3000,https://cobalt-chat-front.vercel.app
DEBUG=true
RSA_KEY_BITS=1024
JWT_EXPIRE_MINUTES=10080
